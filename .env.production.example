# Copy to .env on the server. URLs, ports, hosts and session flags are set
# in docker-compose.prod.yml, only secrets and external services go here.
# Use letters and digits only for passwords (they end up inside URLs).

DOMAIN=example.com
MEDIA_URL=

COOKIE_SECRET=
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
SESSION_FOLDER=sessions:

POSTGRES_USER=teastream
POSTGRES_PASSWORD=
POSTGRES_DATABASE=teastream

REDIS_USER=default
REDIS_PASSWORD=

MAIL_HOST=
MAIL_PORT=
MAIL_LOGIN=
MAIL_PASSWORD=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

TELEGRAM_BOT_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
